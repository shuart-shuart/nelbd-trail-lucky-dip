rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication and Role Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'work@anotherunit.xyz');
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Admins Collection ---
    // Only authenticated administrators have access
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // --- Prizes Collection ---
    // Public read for kiosks; write only by authenticated administrators
    match /prizes/{prizeId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidId(prizeId);
    }

    // --- Inventory Collection ---
    // Public read to inspect available stock for lucky dip draw;
    // Write allowed for administrators OR atomic server-side draw inventory deduction
    match /inventory/{inventoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- Participant Phones Collection (Duplicate Check) ---
    // Enforces: Normalized Singapore mobile number may receive only one prize across festival
    // Public listing is strictly forbidden (PII protection); single get and create permitted for atomic checks
    match /participantPhones/{phoneId} {
      allow get, list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // --- Daily Top Prizes Collection (Daily Lock) ---
    // Enforces: Max one TOP prize awarded per calendar day across both sites in Asia/Singapore timezone
    match /dailyTopPrizes/{date} {
      allow get, list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // --- Participants Collection (PII Protection) ---
    // Phone numbers never exposed through public queries!
    // Public CANNOT list or read participants. Only authenticated admins may read/list.
    match /participants/{participantId} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin() && isValidId(participantId);
    }

    // --- Draws Collection ---
    // Public can get their specific draw; admin can list and manage history
    match /draws/{drawId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin() && isValidId(drawId);
    }

    // --- Inventory Adjustments Audit Log ---
    // Audit logs readable only by authenticated administrators
    match /inventoryAdjustments/{adjustmentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(adjustmentId);
      allow update, delete: if isAdmin();
    }

    // --- Settings Collection ---
    // Public kiosk reads active festival configuration; only admins can write
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(settingId);
    }
  }
}
